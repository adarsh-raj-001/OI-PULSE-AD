# Copy this file to .env and fill in your real values. Never commit .env.
# All non-secret tunables (thresholds, symbols, poll interval) live in
# config.json instead — this file is credentials only.

# From web.dhan.co -> My Profile -> DhanHQ Trading APIs
DHAN_CLIENT_ID=your_client_id_here

# --- Choose ONE authentication mode below ---

# OPTION A (recommended): TOTP auto-refresh. The backend generates its
# own fresh 24h token automatically, forever — no manual regeneration.
# Requires TOTP enabled on your Dhan account first:
#   web.dhan.co -> Profile -> DhanHQ Trading APIs -> Optional Settings
#   -> Set-up TOTP. Save the SECRET KEY it shows you (not just the QR).
# DHAN_PIN is your 6-digit Dhan login PIN.
DHAN_PIN=
DHAN_TOTP_SECRET=

# OPTION B: static token. Simpler, but expires every ~24h and you must
# regenerate + redeploy by hand each time. Only used if OPTION A above
# is left blank.
DHAN_ACCESS_TOKEN=

# Push notification keys. Generate with:  npx web-push generate-vapid-keys
# Leave blank to run without notifications — everything else still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional overrides
PORT=8787
# Lock this to your deployed frontend's origin once you have one,
# e.g. https://your-app.vercel.app — using * is fine for local testing only.
ALLOWED_ORIGIN=*

# Keep-alive: Render web services automatically provide RENDER_EXTERNAL_URL.
# Set this only if another host does not expose its public URL to the process.
# SELF_PING_URL=https://your-service.onrender.com
# DISABLE_SELF_PING=false

# Dhan Live Market Feed is server-side only. It uses the same Dhan credentials
# above and is enabled by config.json when dataSource=dhan. Set true only to
# temporarily keep the REST Option Chain fallback without opening a WebSocket.
# DISABLE_DHAN_LIVE_FEED=false

# Durable raw OI history (recommended for Render). Set this to the INTERNAL
# PostgreSQL connection URL of a database in the same Render region. The URL is
# a secret: keep it in Render's Environment settings, never in Git. The backend
# restores the last 3.6h of compact raw snapshots after a restart so 5m/30m/3h
# calculations resume without a fresh warm-up. DATABASE_URL is also accepted.
# OI_HISTORY_DATABASE_URL=postgresql://...
